# Copy to `.env` locally — never commit real production keys / unit IDs.

EXPO_PUBLIC_APPMETRICA_API_KEY=
EXPO_PUBLIC_ANALYTICS_DEV_MODE=false

# Production banner / interstitial (R-M-digits-digits). Empty → ads off in release.
EXPO_PUBLIC_YANDEX_ADS_BANNER_UNIT_ID=
EXPO_PUBLIC_YANDEX_ADS_INTERSTITIAL_UNIT_ID=

# Legacy aliases still accepted by config:
# EXPO_PUBLIC_YANDEX_BANNER_BLOCK_ID=
# EXPO_PUBLIC_YANDEX_INTERSTITIAL_BLOCK_ID=
